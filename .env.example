# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
# One of: development | test | staging | production
NODE_ENV=development
APP_NAME=nestjs-foundation
PORT=3000
# Optional path prefix mounted before the version segment (e.g. "api" => /api/v1).
# Leave empty for routes served directly under /v1.
API_GLOBAL_PREFIX=

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
# Comma-separated allowlist. Empty disables cross-origin requests.
CORS_ORIGINS=http://localhost:3000
CORS_CREDENTIALS=false

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_foundation?schema=public

# ------------------------------------------------------------------------------
# Swagger / OpenAPI
# ------------------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# ------------------------------------------------------------------------------
# Rate limiting (throttler)
# ------------------------------------------------------------------------------
THROTTLER_TTL_SECONDS=60
THROTTLER_LIMIT=100

# ------------------------------------------------------------------------------
# Auth — access token (RS256, asymmetric)
# Base64-encoded PEM keys. REQUIRED in production; if unset in dev an ephemeral
# keypair is generated at boot. Generate persistent keys with: pnpm auth:keygen
# ------------------------------------------------------------------------------
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_ISSUER=nestjs-foundation
JWT_AUDIENCE=nestjs-foundation

# ------------------------------------------------------------------------------
# Auth — refresh token (opaque, hashed at rest)
# AUTH_REFRESH_TRANSPORT: cookie | body | both
# ------------------------------------------------------------------------------
REFRESH_TOKEN_TTL=7d
AUTH_REFRESH_TRANSPORT=both
AUTH_COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# Auth — account lockout & single-use token lifetimes
# ------------------------------------------------------------------------------
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60

# Public base URL used to build verification/reset links in emails.
APP_PUBLIC_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database seed — bootstrap administrator.
# REQUIRED when NODE_ENV=production; dev falls back to an insecure default.
# Password must be >= 12 characters.
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

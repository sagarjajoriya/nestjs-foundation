// Prisma schema — Phase 1 (infrastructure).
//
// Only the minimal `User` model is defined here. Roles, Permissions,
// OAuthAccount, Session, RefreshToken and AuditLog are intentionally deferred
// to the authentication milestone (Phase 2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// An application user. Kept deliberately minimal for Phase 1; auth-related
/// fields (password hash, roles, sessions) arrive in Phase 2.
model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// Prisma schema — Phase 2 (RBAC + authentication data layer).
//
// Conventions:
//  - UUID primary keys everywhere (`@db.Uuid`).
//  - snake_case table/column names via `@map` / `@@map`.
//  - `createdAt` / `updatedAt` on mutable models; append-only models omit
//    `updatedAt`.
//  - Soft delete (`deletedAt`) only where history/integrity require it.
//  - Secrets are never stored in plaintext (password -> Argon2id hash,
//    refresh token -> SHA-256 hash).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum OAuthProvider {
  GOOGLE
  GITHUB
  MICROSOFT
  DISCORD
  APPLE

  @@map("oauth_provider")
}

/// Purpose of a single-use verification token.
enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_token_type")
}

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

/// An application user.
///
/// NOTE: `email` is intentionally NOT declared `@unique` here. Uniqueness is
/// enforced by a PARTIAL unique index (`email` unique WHERE `deleted_at IS
/// NULL`) created in the migration, so a soft-deleted user's email can be
/// re-registered. Because Prisma cannot model partial indexes, look users up
/// with `findFirst({ where: { email, deletedAt: null } })`.
model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String
  passwordHash     String?   @map("password_hash") // null => OAuth-only account
  name             String?
  isActive         Boolean   @default(true) @map("is_active")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  lastLoginAt      DateTime? @map("last_login_at")
  // Brute-force lockout state (see AUTH_MAX_FAILED_LOGINS / AUTH_LOCKOUT_MINUTES).
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  userRoles          UserRole[]          @relation("UserRoleMember")
  assignedUserRoles  UserRole[]          @relation("UserRoleAssignedBy")
  oauthAccounts      OAuthAccount[]
  sessions           Session[]
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]          @relation("AuditLogActor")

  @@index([deletedAt])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Role / Permission (RBAC)
// ─────────────────────────────────────────────────────────────────────────────

/// A named role. `isSystem` protects the built-in roles (SUPER_ADMIN, ADMIN,
/// USER) from deletion/rename at the application layer while still allowing
/// custom roles to be created at runtime.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

/// A fine-grained permission, identified by a canonical dotted `key`
/// (e.g. "users.read").
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Assignment of a Role to a User. `assignedById` records who granted it
/// (nullable, SetNull) for auditability.
model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User  @relation("UserRoleMember", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([assignedById])
  @@map("user_roles")
}

/// Assignment of a Permission to a Role.
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Authentication
// ─────────────────────────────────────────────────────────────────────────────

/// A linked external identity (OAuth/OIDC). Provider tokens are sensitive and
/// should be encrypted at the application layer before persistence.
model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  accessToken       String?       @map("access_token")
  refreshToken      String?       @map("refresh_token")
  expiresAt         DateTime?     @map("expires_at")
  scope             String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

/// A login session (typically per device/browser). Invalidated via `revokedAt`
/// and/or `expiresAt` rather than deletion.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// A rotating refresh token. Only the SHA-256 `tokenHash` is stored. The
/// self-relation (`replacedById`) forms a rotation chain, enabling reuse/theft
/// detection when an already-rotated token is presented again.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  sessionId    String?   @map("session_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    Session?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken[] @relation("RefreshTokenRotation")

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A single-use, hashed token for email verification or password reset.
/// Only the SHA-256 `tokenHash` is stored; the plaintext is emailed to the user
/// and never persisted. `consumedAt` enforces one-time use.
model VerificationToken {
  id         String                @id @default(uuid()) @db.Uuid
  userId     String                @map("user_id") @db.Uuid
  type       VerificationTokenType
  tokenHash  String                @unique @map("token_hash")
  expiresAt  DateTime              @map("expires_at")
  consumedAt DateTime?             @map("consumed_at")
  createdAt  DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────────

/// Append-only audit trail. Deliberately has no `updatedAt` and no soft delete.
/// `userId` is SetNull so the trail survives actor deletion (compliance).
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation("AuditLogActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

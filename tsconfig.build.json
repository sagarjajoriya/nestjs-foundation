{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pin the source root to `src` so emitted files land at `dist/main.js`
    // (not `dist/src/main.js`). Without this, root-level config files
    // (prisma.config.ts, jest.config.ts) widen the inferred common root.
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
